# ==============================================================================
# PresentMaker — Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Credentials (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!backend/.env.example
!backend-node/.env.example
!frontend/.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 2. Dependencies
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
frontend/node_modules/
backend-node/node_modules/

# Python Virtual Environments
venv/
.venv/
env/
*/venv/
*/.venv/
backend/venv/
backend/.venv/

# ------------------------------------------------------------------------------
# 3. Build & Distribution Directories
# ------------------------------------------------------------------------------
dist/
*/dist/
frontend/dist/
frontend/dist-ssr/
backend-node/dist/
build/
*/build/
out/

# ------------------------------------------------------------------------------
# 4. Python Runtime & Caches
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 5. User Uploads, Backups & Local Data (Private Information)
# ------------------------------------------------------------------------------
uploads/
uploads/**
*/uploads/
backend-node/uploads/
backup/
backup/**
backup_local_presentai_db/
backend-node/backup_local_presentai_db/
.local_db_storage/
*/.local_db_storage/
backend-node/.local_db_storage/
*.dump
*.sql
*.sqlite
*.sqlite3
*.wt

# ------------------------------------------------------------------------------
# 6. Generated Test Decks, Media & Scratch Files
# ------------------------------------------------------------------------------
*.pptx
*.pdf
*.png
*.jpg
*.jpeg
*.mp4
*.webm
!frontend/src/assets/**
!frontend/public/**
scratch/
scratch/**
scratch_*
test_results_summary.json
20
# Local migration, audit verification & scratch scripts
verify_*.cjs
verify_*.mjs
test_*.cjs
test_*.mjs
test_*.py
sync_*.mjs
backup_*.cjs
*.report.md
PRESENTMAKER_ULTIMATE_ENGINEERING_AND_PRODUCTION_READINESS_REPORT.md

# ------------------------------------------------------------------------------
# 7. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.swp
*.bak
*~

# ------------------------------------------------------------------------------
# 8. IDE & Operating System Artifacts
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
.DS_Store
Thumbs.db
Desktop.ini
