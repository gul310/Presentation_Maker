# ==============================================================================
# PresentMaker — Python FastAPI AI Microservice Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the microservice:
#   Copy-Item .env.example .env (PowerShell) or cp .env.example .env (Bash)
# ==============================================================================

PROJECT_NAME=PresentAI API
PROJECT_VERSION=1.0.0
API_V1_STR=/api
ENVIRONMENT=development
DEBUG=True

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT tokens (must match backend-node)
# Generate a secure 32+ character random secret for production
JWT_SECRET_KEY=change_this_to_a_secure_jwt_secret_32_chars_minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# AI Provider Architecture Hierarchy
# ------------------------------------------------------------------------------
# Priority 1: Primary AI Provider (gemini)
# Priority 2: Secondary AI Fallback (groq)
# Priority 3: Tertiary Fallback (deepseek, optional)
# Priority 4: Deterministic Local Synthesis Engine (always available offline)
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_ENABLED=true

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Primary Provider)
# ------------------------------------------------------------------------------
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
# Leave empty if testing offline with Groq or local synthesizer
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Groq Cloud LPU API (Secondary Fallback Provider)
# ------------------------------------------------------------------------------
# Obtain your API key from Groq Console: https://console.groq.com/keys
# Supported models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 3. DeepSeek API (Optional Tertiary Fallback)
# ------------------------------------------------------------------------------
# Obtain from https://platform.deepseek.com/ (Optional)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
