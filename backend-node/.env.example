# ==============================================================================
# PresentMaker — Node.js Express Backend Gateway Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the backend gateway:
#   Copy-Item .env.example .env (PowerShell) or cp .env.example .env (Bash)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Database Connection
# ------------------------------------------------------------------------------
# Standard MongoDB Atlas connection string or local MongoDB instance:
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/presentmaker?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/presentmaker
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/presentmaker?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# ------------------------------------------------------------------------------
# Secret key used for signing user authentication JWTs (must match backend/.env)
JWT_SECRET=change_this_to_a_secure_jwt_secret_32_chars_minimum
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CORS & Inter-Service URLs
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PYTHON_AI_SERVICE_URL=http://127.0.0.1:8002

# ------------------------------------------------------------------------------
# Freemium & Guest User Limits
# ------------------------------------------------------------------------------
MAX_GUEST_GENERATIONS=2

# ------------------------------------------------------------------------------
# Unsplash API Integration (Automatic Photography & Image Placement)
# ------------------------------------------------------------------------------
# Register an application at https://unsplash.com/developers to obtain credentials
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# ------------------------------------------------------------------------------
# AI Microservice Reference (Mirror of Python backend settings)
# ------------------------------------------------------------------------------
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
